<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>EsilvaSoft.KapibaraStudio.KapiLab</AssemblyName>
    <RootNamespace>EsilvaSoft.KapibaraStudio.KapiLab</RootNamespace>
    <DefineConstants Condition="'$(SlopOnnxBackend)' == 'Cpu'">$(DefineConstants);KAPILAB_BACKEND_CPU</DefineConstants>
    <DefineConstants Condition="'$(SlopOnnxBackend)' == 'WinML'">$(DefineConstants);KAPILAB_BACKEND_WINML</DefineConstants>
    <DefineConstants Condition="'$(SlopOnnxBackend)' == 'Cuda'">$(DefineConstants);KAPILAB_BACKEND_CUDA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="KapibaraStudio.GenAiVersion" Value="$(KapibaraGenAiVersion)" />
    <AssemblyMetadata Include="KapibaraStudio.OnnxBackend" Value="$(SlopOnnxBackend)" />
    <Content Include="Fixtures/autocomplete-raw-ghost-v1.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EsilvaSoft.KapibaraStudio.KapiLab.Tests" />
    <InternalsVisibleTo Include="EsilvaSoft.KapibaraStudio.KapiLab.GpuLockChild" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.10" />
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Application/EsilvaSoft.KapibaraStudio.Application.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Autocomplete.Core/EsilvaSoft.KapibaraStudio.Autocomplete.Core.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Infrastructure/EsilvaSoft.KapibaraStudio.Infrastructure.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.LocalAi.Core/EsilvaSoft.KapibaraStudio.LocalAi.Core.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Infrastructure.LocalAi.OnnxAdapter/EsilvaSoft.KapibaraStudio.Infrastructure.LocalAi.OnnxAdapter.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Infrastructure.System/EsilvaSoft.KapibaraStudio.Infrastructure.System.csproj" />
  </ItemGroup>
</Project>
