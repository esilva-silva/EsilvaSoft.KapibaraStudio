<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <KapibaraGenAiVersion>0.18.0</KapibaraGenAiVersion>
    <!-- The managed ORT asks the native runtime for its own API version. Cpu/Cuda ship native ORT 1.31 with GenAI;
         WinML loads ORT 1.24.6 from Microsoft.Windows.AI.MachineLearning 2.1.1, which rejects API 31, so WinML must
         stay on a managed version that negotiates down (1.30.0 verified). Raise only together with the WinML runtime. -->
    <KapibaraOrtManagedVersion>1.31.0</KapibaraOrtManagedVersion>
    <KapibaraOrtManagedVersion Condition="'$(SlopOnnxBackend)' == 'WinML'">1.30.0</KapibaraOrtManagedVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="$(KapibaraGenAiVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.WinML" Version="$(KapibaraGenAiVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="$(KapibaraGenAiVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="$(KapibaraOrtManagedVersion)" />
    <PackageVersion Include="Qualcomm.ML.OnnxRuntime.QNN" Version="2.7.0" />
    <PackageVersion Include="Jint" Version="4.16.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="MongoDB.Driver" Version="3.11.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageVersion Include="Anthropic" Version="12.50.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
</Project>
