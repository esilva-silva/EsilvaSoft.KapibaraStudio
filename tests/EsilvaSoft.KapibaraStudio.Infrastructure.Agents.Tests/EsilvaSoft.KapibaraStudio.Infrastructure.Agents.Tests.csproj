<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testes offline dos adapters externos. Projeto separado de UnitTests para não unificar a árvore de dependências
    dos SDKs de provider com a do ONNX local (Microsoft.Extensions.AI.Abstractions).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Infrastructure.Agents/EsilvaSoft.KapibaraStudio.Infrastructure.Agents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Mesmo override do projeto testado (OpenAI -> System.ClientModel exige >= 10.0.9); evita NU1109 transitivo. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.10" />
  </ItemGroup>
</Project>
