<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measurement tool for autocomplete; not part of the product and never published. -->
  <!-- NUnit validates the development tools only when explicitly opted in locally.
       Program.cs owns the BenchmarkSwitcher entry point. CI/release never opt in. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="'$(EnableBenchmarkTests)' == 'true'">true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Autocomplete.Core/EsilvaSoft.KapibaraStudio.Autocomplete.Core.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.LocalAi.Core/EsilvaSoft.KapibaraStudio.LocalAi.Core.csproj" />
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Application/EsilvaSoft.KapibaraStudio.Application.csproj" />
    <!-- L16: os benchmarks de commit de schema aprendido medem o repositorio LiteDB real, nao um fake. -->
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Infrastructure/EsilvaSoft.KapibaraStudio.Infrastructure.csproj" />
    <!-- A44: o AiRuntimeHarness mede modelos ONNX reais; sem esta referencia so haveria fake, e fake nao prova real. -->
    <ProjectReference Include="../../src/EsilvaSoft.KapibaraStudio.Infrastructure.LocalAi/EsilvaSoft.KapibaraStudio.Infrastructure.LocalAi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.10" />
  </ItemGroup>
</Project>
