<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testes offline dos adapters externos. Projeto separado de UnitTests para não unificar a árvore de dependências
    dos SDKs de provider com a do ONNX local (Microsoft.Extensions.AI.Abstractions).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/EsilvaSoft.SlopStudio.Infrastructure.Agents/EsilvaSoft.SlopStudio.Infrastructure.Agents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Mesmo override do projeto testado (OpenAI -> System.ClientModel exige >= 10.0.9); evita NU1109 transitivo. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixtures stream-json do CLI falso do Claude Code (derivadas do spike P7-CL0-01; ver generate_fixtures.py). -->
    <None Include="ClaudeCode/Fixtures/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
