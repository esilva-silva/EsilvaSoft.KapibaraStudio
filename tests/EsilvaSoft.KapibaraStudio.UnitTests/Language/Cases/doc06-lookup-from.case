// spec: 06-editor-bson-e-uuid.md §Casos obrigatórios ($lookup: coleção estrangeira); mongodb-language.v1.json LookupBody.from = CollectionNameString; MongoDB: $lookup só referencia coleções do mesmo banco
db.Pedidos.aggregate([
    { $lookup: { from: "|", localField: "clienteId", foreignField: "Id", as: "cliente" } }
])
