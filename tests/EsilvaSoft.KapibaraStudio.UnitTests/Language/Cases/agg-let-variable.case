// spec: testing.md §Fixtures ($$ e variáveis de let); AggregationFieldInferenceTests (let em $lookup publica $customerId e não campo); context-engine.md §Localização (VariableReferenceString)
db.Pedidos.aggregate([ { $lookup: { from: "Clientes", let: { pedidoCliente: "$clienteId" }, pipeline: [ { $match: { $expr: { $eq: [ "$Id", "$$|" ] } } } ], as: "cliente" } } ])
