<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Proxy MCP por STDIO (lote 3 da fase 7). Referencia apenas Core/Application: não referencia Infrastructure,
    LiteDB, MongoDB.Driver nem providers. O pacote MCP fica confinado a este executável.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- P7-CLP-3: published self-contained next to the Desktop (mcp/) for the same RIDs, so the lock files carry the
         runtime sections and the RID-less locked restore stays valid for `dotnet publish -r <rid>`. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EsilvaSoft.KapibaraStudio.Core/EsilvaSoft.KapibaraStudio.Core.csproj" />
    <ProjectReference Include="../EsilvaSoft.KapibaraStudio.Application/EsilvaSoft.KapibaraStudio.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <!-- ModelContextProtocol.Core 2.2.0 exige >= 10.0.10; o pin central (10.0.0) é mantido nos demais projetos. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EsilvaSoft.KapibaraStudio.UnitTests" />
  </ItemGroup>
</Project>
