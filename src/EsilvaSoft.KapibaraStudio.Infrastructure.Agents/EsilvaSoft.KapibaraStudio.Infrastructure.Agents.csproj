<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Adapters de providers externos da fase 7 (lote 7: OpenAI API direta). Referencia apenas Core/Application:
    os DTOs do SDK OpenAI ficam confinados a este assembly e nunca atravessam as portas do runtime.
  -->
  <ItemGroup>
    <ProjectReference Include="../EsilvaSoft.KapibaraStudio.Core/EsilvaSoft.KapibaraStudio.Core.csproj" />
    <ProjectReference Include="../EsilvaSoft.KapibaraStudio.Application/EsilvaSoft.KapibaraStudio.Application.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- OpenAI 2.14.0 -> System.ClientModel 1.15.0 exige >= 10.0.9; o pin central (10.0.0) segue nos demais projetos. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.10" />
    <!-- Lote 8: Claude API (pasta Anthropic/, namespace ...Agents.Anthropic). -->
    <PackageReference Include="Anthropic" />
    <!-- P7-COP-01: SDK oficial do GitHub Copilot; autenticação delegada à CLI, sem API key do produto. -->
    <PackageReference Include="GitHub.Copilot.SDK" />
    <!-- SQLite do SessionFs volátil do SDK Copilot, para conversas com retenção de histórico desativada. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EsilvaSoft.KapibaraStudio.UnitTests" />
    <InternalsVisibleTo Include="EsilvaSoft.KapibaraStudio.Infrastructure.Agents.Tests" />
  </ItemGroup>
</Project>
