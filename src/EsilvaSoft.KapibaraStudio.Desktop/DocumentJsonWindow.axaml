<Window xmlns="https://github.com/avaloniaui" xmlns:syntax="using:EsilvaSoft.KapibaraStudio.Desktop.SyntaxHighlighting" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.KapibaraStudio.Desktop.ViewModels" xmlns:local="using:EsilvaSoft.KapibaraStudio.Desktop" x:Class="EsilvaSoft.KapibaraStudio.Desktop.DocumentJsonWindow" x:DataType="vm:DocumentJsonViewModel" Title="{Binding WindowTitle}" Width="760" Height="560" MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Margin="20">
    <StackPanel Spacing="2">
      <TextBlock x:Name="HeadingText" Text="{Binding Heading}" Classes="section-title" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Heading}"/>
      <TextBlock Text="{local:Loc Key=readOnlyView}" Classes="metadata" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
      <TextBlock Text="{local:Loc Key=origin}" Classes="metadata" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" x:Name="OriginText" Text="{Binding Origin}" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="1" Text="{local:Loc Key=destination}" Classes="metadata" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DestinationText" Text="{Binding Destination}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBlock Grid.Row="2" Text="{local:Loc Key=identity}" Classes="metadata" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Identity}" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="3" Text="{local:Loc Key=presentation}" Classes="metadata" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Presentation}" TextWrapping="Wrap" Classes="metadata"/>
    </Grid>
    <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Grid.Row="2" x:Name="JsonText" Text="{Binding Json, Mode=OneWay}" IsReadOnly="True" Classes="code syntax" FontSize="{Binding CodeFontSize}" LineHeight="{Binding CodeLineHeight}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:Loc Key=formattedJsonReadOnly}"/>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="metadata"/>
      <Button Grid.Column="1" x:Name="CopyButton" Content="{local:Loc Key=copyJson}" Click="CopyJson" Classes="primary" ToolTip.Tip="{local:Loc Key=copyJsonTooltip}"/>
      <Button Grid.Column="2" Content="{local:Loc Key=close}" Click="CloseDialog" ToolTip.Tip="{local:Loc Key=closeEsc}"/>
    </Grid>
  </Grid>
</Window>
