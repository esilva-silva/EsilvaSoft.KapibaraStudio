<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.KapibaraStudio.Desktop.ViewModels" xmlns:local="using:EsilvaSoft.KapibaraStudio.Desktop" x:Class="EsilvaSoft.KapibaraStudio.Desktop.AgentChatPanel" x:DataType="vm:AgentChatViewModel" x:CompileBindings="True" MinWidth="320" AutomationProperties.Name="{local:Loc Key=agentPanelTitle}">
  <UserControl.Resources>
    <ControlTheme x:Key="CompactDisclosureToggle" TargetType="ToggleButton">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="DisclosureBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:focus-visible /template/ Border#DisclosureBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.6" /></Style>
    </ControlTheme>
    <ControlTheme x:Key="CompactAgentExpander" TargetType="Expander">
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <ToggleButton Theme="{StaticResource CompactDisclosureToggle}" HorizontalAlignment="Stretch" x:Name="PART_ExpandCollapseButton" MinHeight="28" Height="32" Padding="4,2" HorizontalContentAlignment="Stretch"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PrimaryText}"
                          AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="⌄" Classes="expand-arrow" VerticalAlignment="Center" />
              </Grid>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{TemplateBinding IsExpanded}" Margin="0,4,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Expander /template/ ToggleButton:checked TextBlock.expand-arrow">
      <Setter Property="Text" Value="⌃" />
    </Style>
    <Style Selector="TextBox#Composer:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton /template/ Border">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="ListBox#History > ListBoxItem">
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox#History > ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.agent-message">
      <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.agent-message.user">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Margin" Value="24,0,0,0" />
    </Style>
    <!-- Chips of the panel: HoverBrush + DividerBrush outline keep the chip visible on PanelBackground in both themes
         (SecondaryBackground is almost the panel color in the dark theme). -->
    <Style Selector="Border.type-chip">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.type-chip.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.read-notice">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.read-notice.critical">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.agent-notice">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="Border.agent-notice.warning">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.agent-notice.error">
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Border.agent-approval">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4" Margin="8">
      <ScrollViewer x:Name="HeaderScroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding ConversationTitle}" ToolTip.Tip="{Binding ConversationTitle}" AutomationProperties.Name="{Binding ConversationTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" x:Name="HistoryButton" Content="◷" Classes="quiet" Padding="6,2" MinWidth="28" ToolTip.Tip="{local:Loc Key=agentHistory}" Click="ShowHistory" AutomationProperties.Name="{local:Loc Key=agentHistory}">
            <Button.Flyout><Flyout><StackPanel Width="340" Spacing="6" Margin="8"><TextBox Text="{Binding HistorySearch}" PlaceholderText="{local:Loc Key=agentHistorySearch}"/><TextBlock Text="{Binding HistoryStatus}" Classes="metadata" TextWrapping="Wrap"/><ScrollViewer MaxHeight="360"><ItemsControl ItemsSource="{Binding HistoryItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AgentHistoryItemViewModel"><StackPanel Spacing="3"><Button Content="{Binding DisplayTitle}" HorizontalContentAlignment="Left" Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).OpenHistoryItemCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsReadable}"/><TextBlock Text="{Binding MetaText}" Classes="metadata"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Content="{local:Loc Key=agentHistoryDelete}" Command="{Binding BeginDeleteCommand}" IsVisible="{Binding IsIdle}"/><TextBlock Text="{local:Loc Key=agentHistoryConfirmDelete}" IsVisible="{Binding IsConfirmingDelete}"/><Button Content="{local:Loc Key=cancel}" Command="{Binding CancelDeleteCommand}" IsVisible="{Binding IsConfirmingDelete}"/><Button Content="{local:Loc Key=delete}" Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).ConfirmDeleteCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsConfirmingDelete}"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Flyout></Button.Flyout>
          </Button>
          <Button Grid.Column="2" Classes="quiet" Content="＋" Padding="6,2" MinWidth="28" ToolTip.Tip="{local:Loc Key=agentNewConversation}" Command="{Binding NewConversationCommand}" AutomationProperties.Name="{local:Loc Key=agentNewConversation}" />
          <Button Grid.Column="3" x:Name="ConfigureButton" Classes="quiet" Content="⚙" Padding="6,2" MinWidth="28" ToolTip.Tip="{local:Loc Key=agentConfigure}" Command="{Binding ConfigureCommand}" AutomationProperties.Name="{local:Loc Key=agentConfigure}" />
          <Button Grid.Column="4" x:Name="ClosePanelButton" Content="×" Classes="quiet" Padding="8,0" MinWidth="32" IsVisible="False" Click="OnClosePanelClick" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox x:Name="ProviderSelector" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" IsEnabled="{Binding CanChangeProvider}" MaxDropDownHeight="320" PlaceholderText="{local:Loc Key=agentProvider}" AutomationProperties.Name="{local:Loc Key=agentProvider}" AutomationProperties.HelpText="{Binding ProviderSummary}" ToolTip.Tip="{Binding ProviderSummary}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentProviderOption">
                <StackPanel MaxWidth="260" Spacing="2" Margin="0,2">
                  <TextBlock Text="{Binding Presentation.DisplayName}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ListDetail}" Classes="metadata" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:AgentProviderOption">
                <TextBlock Text="{Binding $parent[ComboBox].((vm:AgentChatViewModel)DataContext).ProviderSummary}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <Border Grid.Column="1" Classes="type-chip" VerticalAlignment="Center" Padding="6,2" IsVisible="{Binding SelectedProvider, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding DestinationHint}">
            <TextBlock x:Name="DestinationBadge" Text="{Binding DestinationText}" Classes="metadata" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
          </Border>
        </Grid>
        <Border x:Name="ReadScopeNotice" Classes="read-notice" Classes.critical="{Binding IsReadScopeCritical}" IsVisible="{Binding HasReadScope}">
          <StackPanel>
            <TextBlock Text="{Binding ReadScopeText}" Classes="metadata" TextWrapping="Wrap" IsVisible="{Binding IsReadScopeCritical}" />
            <Expander Theme="{StaticResource CompactAgentExpander}" x:Name="ReadScopeDetails" AutomationProperties.Name="{Binding ReadScopeSummary}" Header="{Binding ReadScopeSummary}" IsVisible="{Binding !IsReadScopeCritical}" HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding ReadScopeText}" Classes="metadata" TextWrapping="Wrap" />
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" Padding="4,0" VerticalAlignment="Top" IsVisible="{Binding ShowStatusArea}">
        <ScrollViewer x:Name="StatusScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PersistenceNotice" Text="{Binding ActivePersistenceText}" IsVisible="{Binding HasActivePersistenceText}" Classes="metadata" Classes.error="{Binding ActivePersistenceIsError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="HistoryFailureNotice" Text="{Binding HistoryStatus}" IsVisible="{Binding HistoryStatusIsError}" Classes="metadata error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="StatusLine" IsVisible="{Binding ShowStatusLine}" Text="{Binding StatusSummary}" TextWrapping="Wrap" ToolTip.Tip="{Binding StatusText}" AutomationProperties.HelpText="{Binding StatusText}" Classes.error="{Binding IsStatusError}" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="RetryAvailabilityButton" HorizontalAlignment="Right" Content="{Binding AvailabilityActionText}" Command="{Binding RetryAvailabilityCommand}" IsVisible="{Binding ShowAvailabilityRetry}" ToolTip.Tip="{local:Loc Key=agentRefreshProvidersHint}" />
          <Button x:Name="RefreshProvidersButton" HorizontalAlignment="Right" Content="{local:Loc Key=agentRefreshProviders}" Command="{Binding RefreshProvidersCommand}" IsVisible="{Binding ShowRefreshProviders}" ToolTip.Tip="{local:Loc Key=agentRefreshProvidersHint}" AutomationProperties.Name="{local:Loc Key=agentRefreshProviders}" AutomationProperties.HelpText="{local:Loc Key=agentRefreshProvidersHint}" />
        </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="2" MinHeight="96" x:Name="ConversationRegion">
        <ListBox x:Name="History" ItemsSource="{Binding Items}" AutomationProperties.Name="{local:Loc Key=agentHistory}" Background="{DynamicResource PanelBackground}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:AgentReasoningItem">
              <Border Background="{DynamicResource WorkspaceBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2">
                <StackPanel Spacing="4">
                  <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ToggleExpandedCommand}"
                          Content="{Binding Header}" AutomationProperties.Name="{Binding Header}" />
                  <TextBlock Text="{Binding SafetyNotice}" Classes="metadata" TextWrapping="Wrap" />
                  <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap" IsVisible="{Binding IsExpanded}" />
                  <TextBlock Text="{Binding BudgetNotice}" Classes="metadata" IsVisible="{Binding TruncatedByBudget}" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentChatMessageItem">
              <Border Classes="agent-message" Classes.user="{Binding IsUser}">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding RoleLabel}" Classes="metadata" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StreamingLabel}" Classes="metadata" IsVisible="{Binding IsStreaming}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AgentChatMessageBlock">
                        <StackPanel Spacing="4">
                          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20" IsVisible="{Binding !IsCode}" />
                          <Border Background="{DynamicResource WorkspaceBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="8" IsVisible="{Binding IsCode}">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Language}" Classes="metadata" IsVisible="{Binding HasLanguage}" />
                              <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding Text}" FontFamily="{StaticResource CodeFont}" FontSize="14" LineHeight="21" />
                              </ScrollViewer>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding AttachmentsText}" Classes="metadata" TextWrapping="Wrap" IsVisible="{Binding HasAttachments}" />
                  <Button Content="{local:Loc Key=agentContextDetails}" IsVisible="{Binding HasContextMetrics}"
                          AutomationProperties.Name="{local:Loc Key=agentContextDetails}">
                    <Button.Flyout>
                      <Flyout><Border MaxWidth="360" MaxHeight="280" Padding="10" Background="{DynamicResource PanelBackground}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                          <TextBlock Text="{Binding ContextMetricsDetails}" TextWrapping="Wrap" MaxWidth="340" />
                        </ScrollViewer>
                      </Border></Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentToolCallItem">
              <Border Classes="card" Padding="8,6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                  <TextBlock Text="{Binding OriginText}" Classes="metadata" TextWrapping="Wrap" IsVisible="{Binding HasOriginText}" />
                  <TextBlock Text="{Binding StatusText}" Classes="metadata" Classes.error="{Binding IsError}" TextWrapping="Wrap" />
                  <Button Content="{local:Loc Key=agentOpenPermissions}" IsVisible="{Binding CanReviewPermissions}"
                          Command="{Binding $parent[ListBox].((vm:AgentChatViewModel)DataContext).OpenPermissionsCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentToolConfirmationCardItem">
              <Border Classes="card" Padding="8" Margin="2" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                  <TextBlock Text="{Binding CategoryText}" Classes="metadata" TextWrapping="Wrap"/>
                  <TextBox Text="{Binding InputText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" IsVisible="{Binding HasInput}"/>
                  <TextBlock Text="{Binding StatusText}" Classes="metadata" TextWrapping="Wrap"/>
                  <WrapPanel IsVisible="{Binding IsPending}">
                    <Button Content="{local:Loc Key=agentConfirmAllowOnce}" Command="{Binding ApproveOnceCommand}" Margin="0,0,6,0"/>
                    <Button Content="{local:Loc Key=agentConfirmAllowSession}" Command="{Binding ApproveThisSessionCommand}" IsVisible="{Binding CanApproveThisSession}" Margin="0,0,6,0"/>
                    <Button Content="{local:Loc Key=agentConfirmDeny}" Command="{Binding RejectCommand}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentApprovalCardItem">
              <Border Classes="card agent-approval" Padding="8,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Classes="metadata" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding ReviewLabel}" IsVisible="{Binding IsPending}" Command="{Binding $parent[ListBox].((vm:AgentChatViewModel)DataContext).OpenApprovalCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding ReviewLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentEditProposalCardItem">
              <Border Classes="card" Padding="8" Margin="2">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !HasPersistedCounts}"
                              AutomationProperties.Name="{Binding CountsAccessibleText}">
                    <Border Background="{DynamicResource AgentAddedBackgroundBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding AddedCountText}" Foreground="{DynamicResource SuccessBrush}" />
                    </Border>
                    <Border Background="{DynamicResource AgentRemovedBackgroundBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                      <TextBlock Text="{Binding RemovedCountText}" Foreground="{DynamicResource ErrorBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding PersistedCounts}" Classes="metadata" IsVisible="{Binding HasPersistedCounts}"
                             AutomationProperties.Name="{Binding CountsAccessibleText}" />
                  <TextBlock Text="{Binding StatusText}" Classes="metadata" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ErrorText}" Classes="metadata" Classes.error="{Binding HasError}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                  <WrapPanel>
                    <Button Content="{local:Loc Key=agentProposalReview}" Classes="agent-review" Command="{Binding ReviewCommand}" IsEnabled="{Binding IsAvailable}" Margin="0,0,6,0" />
                    <Button Content="{local:Loc Key=agentProposalApplyAll}" Classes="agent-apply" Command="{Binding ApplyAllCommand}" IsVisible="{Binding ShowApplyDiscard}" IsEnabled="{Binding CanApply}" Margin="0,0,6,0" />
                    <Button Content="{local:Loc Key=agentProposalDiscard}" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowApplyDiscard}" IsEnabled="{Binding CanDiscard}" />
                    <Button Content="{local:Loc Key=agentProposalKeep}" Command="{Binding KeepCommand}" IsVisible="{Binding ShowKeepRevert}" Margin="0,0,6,0" />
                    <Button Content="{local:Loc Key=agentProposalRevert}" Command="{Binding RevertCommand}" IsVisible="{Binding ShowKeepRevert}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentChatNoticeItem">
              <Border Classes="agent-notice" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" Padding="8" CornerRadius="4">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{local:Loc Key=agentNotice}" Classes="metadata" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TimeText}" Classes="metadata" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Content}" Classes="metadata" Classes.error="{Binding IsError}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
        <StackPanel x:Name="EmptyState" IsVisible="{Binding ShowEmptyInvitation}" VerticalAlignment="Center" Margin="16" Spacing="6" IsHitTestVisible="False">
          <TextBlock Text="{local:Loc Key=agentEmptyTitle}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{local:Loc Key=agentEmptyBody}" Classes="metadata" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
        <Button x:Name="LatestMessageButton" Content="{local:Loc Key=agentLatestMessage}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" IsVisible="False" Click="OnLatestMessageClick" />
      </Grid>
      <Border Grid.Row="3" x:Name="ComposerSurface" Background="{DynamicResource SecondaryBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
      <StackPanel Spacing="4">
        <ScrollViewer x:Name="ComposerDetailsScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="4">
        <Border Classes="card" Padding="8" IsVisible="{Binding IsSendBlocked}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="{Binding SendBlockText}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="{Binding SendBlockActionText}" Command="{Binding ResolveSendBlockCommand}" IsVisible="{Binding HasSendBlockAction}"/></Grid>
        </Border>
        <Expander Theme="{StaticResource CompactAgentExpander}" x:Name="ContextDetails" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding ContextMetricsSummary}">
          <Expander.Header>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
              <TextBlock Text="{Binding ContextMetricsSummary}" Classes="metadata" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="1" x:Name="ContextMetricsButton" Content="{local:Loc Key=agentContextDetails}" Padding="6,3" MinHeight="28" ToolTip.Tip="{Binding ContextMetricsSummary}"
                      AutomationProperties.Name="{local:Loc Key=agentContextDetails}">
                <Button.Flyout><Flyout><Border Width="300" MaxHeight="280" Padding="10" Background="{DynamicResource PanelBackground}">
                  <ScrollViewer Width="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ContextMetricsDetails}" TextWrapping="Wrap" Width="280" />
                  </ScrollViewer>
                </Border></Flyout></Button.Flyout>
              </Button>
            </Grid>
          </Expander.Header>
          <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ContextChips" ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentContextChipViewModel">
              <Border Classes="type-chip" Classes.warning="{Binding HasError}" Margin="0,0,4,4" Padding="6,2" ToolTip.Tip="{Binding Tooltip}" MaxWidth="280">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBlock Text="{Binding Label}" Classes="metadata" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" MaxWidth="210" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="×" Classes="quiet" Padding="2,0" MinWidth="24" MinHeight="24" Height="24" Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).RemoveChipCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding RemoveLabel}" />
                  </Grid>
                  <TextBlock Text="{Binding ErrorText}" Classes="metadata" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
          </ScrollViewer>
        </Expander>
        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
        <ComboBox HorizontalAlignment="Stretch" x:Name="ModeSelector" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{local:Loc Key=agentModeOperation}" ToolTip.Tip="{Binding SelectedModeHint}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AgentModeOption"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Hint}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
          <ComboBox Grid.Column="1" x:Name="ModelSelector" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsVisible="{Binding HasModels}" IsEnabled="{Binding CanChangeProvider}" AutomationProperties.Name="{local:Loc Key=agentModel}" AutomationProperties.HelpText="{Binding SelectedModel}" ToolTip.Tip="{Binding SelectedModel}" />
          <Button Grid.Column="2" x:Name="UsageButton" Content="{local:Loc Key=agentUsage}" Padding="8,3" MinHeight="28" ToolTip.Tip="{local:Loc Key=agentUsage}"
                  AutomationProperties.Name="{local:Loc Key=agentUsage}">
            <Button.Flyout><Flyout><Border Width="300" MaxHeight="320" Padding="10" Background="{DynamicResource PanelBackground}">
              <ScrollViewer Width="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding UsageDetails}" TextWrapping="Wrap" Width="280" />
              </ScrollViewer>
            </Border></Flyout></Button.Flyout>
          </Button>
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsReasoningOptionVisible}">
          <CheckBox x:Name="ReasoningToggle" Content="{local:Loc Key=agentReasoningToggle}" IsChecked="{Binding ReasoningEnabled}"
                    IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{local:Loc Key=agentReasoningToggle}" />
          <TextBlock Grid.Column="1" Text="{local:Loc Key=agentReasoningBudget}" Classes="metadata" VerticalAlignment="Center" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding ReasoningBudgets}" SelectedItem="{Binding SelectedReasoningBudget}"
                    IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{local:Loc Key=agentReasoningBudget}" MinWidth="92" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsReasoningRetentionVisible}">
          <CheckBox x:Name="RetainReasoningToggle" Content="{local:Loc Key=agentReasoningRetainToggle}"
                    IsChecked="{Binding PersistReasoning}" IsEnabled="{Binding IsIdle}"
                    AutomationProperties.Name="{local:Loc Key=agentReasoningRetainToggle}" />
          <TextBlock Text="{local:Loc Key=agentReasoningRetentionDays}" Classes="metadata" VerticalAlignment="Center" />
          <ComboBox x:Name="ReasoningRetentionSelector" ItemsSource="{Binding ReasoningRetentionOptions}"
                    SelectedItem="{Binding ReasoningRetentionDays}" IsEnabled="{Binding IsIdle}"
                    AutomationProperties.Name="{local:Loc Key=agentReasoningRetentionDays}" MinWidth="72" />
        </StackPanel>
        <TextBox x:Name="Composer" Text="{Binding ComposerText}" IsEnabled="{Binding IsComposerEnabled}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" PlaceholderText="{local:Loc Key=agentComposerPlaceholder}" AutomationProperties.Name="{local:Loc Key=agentComposer}" ToolTip.Tip="{local:Loc Key=agentComposerShortcut}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        </ScrollViewer>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Text="{local:Loc Key=agentComposerHelp}" Classes="metadata" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="CopilotDataUseButton" Content="{local:Loc Key=agentCopilotDataUse}" IsVisible="{Binding IsCopilotSubscriptionSelected}"
                  Padding="6,2" MinHeight="28" ToolTip.Tip="{local:Loc Key=agentCopilotDataUseTitle}"
                  AutomationProperties.Name="{local:Loc Key=agentCopilotDataUseTitle}">
            <Button.Flyout>
              <Flyout>
                <Border Width="280" MaxHeight="400" Padding="10" Background="{DynamicResource PanelBackground}">
                  <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="0,0,12,0">
                      <TextBlock Text="{local:Loc Key=agentCopilotDataUseTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{local:Loc Key=agentCopilotDataUseSent}" Classes="metadata" TextWrapping="Wrap" />
                      <TextBlock Text="{local:Loc Key=agentCopilotDataUsePolicy}" Classes="metadata" TextWrapping="Wrap" />
                      <TextBlock Text="{local:Loc Key=agentCopilotDataUseLocal}" Classes="metadata" TextWrapping="Wrap" />
                      <TextBlock Text="{local:Loc Key=agentCopilotUsageNotice}" Classes="metadata" TextWrapping="Wrap" />
                      <TextBlock Text="{local:Loc Key=agentCopilotOutputReview}" Classes="metadata" TextWrapping="Wrap" />
                      <HyperlinkButton x:Name="CopilotUsageLink"
                                       NavigateUri="https://docs.github.com/en/copilot/reference/copilot-billing/models-and-pricing"
                                       Padding="0" HorizontalAlignment="Left"
                                       AutomationProperties.Name="{local:Loc Key=agentCopilotUsageLink}">
                        <TextBlock Text="{local:Loc Key=agentCopilotUsageLink}" TextWrapping="Wrap" />
                      </HyperlinkButton>
                      <HyperlinkButton x:Name="CopilotAccessLink"
                                       NavigateUri="https://docs.github.com/en/copilot/how-tos/copilot-on-github/set-up-copilot/configure-access-to-ai-models"
                                       Padding="0" HorizontalAlignment="Left"
                                       AutomationProperties.Name="{local:Loc Key=agentCopilotAccessLink}">
                        <TextBlock Text="{local:Loc Key=agentCopilotAccessLink}" TextWrapping="Wrap" />
                      </HyperlinkButton>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" x:Name="CancelTurnButton" Content="{local:Loc Key=agentCancelTurn}" Command="{Binding CancelTurnCommand}" IsVisible="{Binding IsBusy}" VerticalAlignment="Top" ToolTip.Tip="{local:Loc Key=agentApprovalCancelNotice}" />
          <Button DockPanel.Dock="Right" x:Name="SendButton" Content="{local:Loc Key=agentSend}" Classes="primary" Command="{Binding SendCommand}" IsVisible="{Binding IsIdle}" IsEnabled="{Binding IsComposerEnabled}" VerticalAlignment="Top" ToolTip.Tip="{local:Loc Key=agentComposerShortcut}" />
          <WrapPanel Margin="0,0,8,0">
          <Button x:Name="AttachButton" Content="{local:Loc Key=agentAttach}" Padding="6,4" Margin="0,0,4,0" AutomationProperties.Name="{local:Loc Key=agentAttach}">
            <Button.Flyout><Flyout>
        <StackPanel Spacing="4"><Button x:Name="WorkspaceFileButton" Content="{local:Loc Key=agentAttachWorkspaceFile}" Command="{Binding AttachWorkspaceFileCommand}"><Button.Flyout><Flyout><StackPanel Width="340" Spacing="6" Margin="8"><TextBox Text="{Binding WorkspaceFilePicker.Search}" PlaceholderText="{local:Loc Key=agentWorkspaceFileSearch}"/><TextBlock Text="{Binding WorkspaceFilePicker.Status}" Classes="metadata" TextWrapping="Wrap"/><ScrollViewer MaxHeight="320"><ItemsControl ItemsSource="{Binding WorkspaceFilePicker.Files}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AgentWorkspaceFileChoice"><Button Content="{Binding RelativePath}" HorizontalContentAlignment="Left" Click="SelectWorkspaceFile" ToolTip.Tip="{local:Loc Key=agentAttachWorkspaceFileTooltip}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Flyout></Button.Flyout></Button><Button Content="{local:Loc Key=agentAttachExternalFile}" Command="{Binding AttachExternalFileCommand}" IsEnabled="{Binding CanAttachExternal}"/></StackPanel>
            </Flyout></Button.Flyout>
          </Button>
<Button Content="{local:Loc Key=agentOpenPermissions}" Command="{Binding OpenPermissionsCommand}" Padding="6,4" ToolTip.Tip="{Binding PermissionsSummary}" />
          </WrapPanel>
        </DockPanel>
      </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
