<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:EsilvaSoft.KapibaraStudio.Desktop" xmlns:vm="using:EsilvaSoft.KapibaraStudio.Desktop.ViewModels" x:Class="EsilvaSoft.KapibaraStudio.Desktop.UuidRepresentationPanel" x:DataType="vm:UuidPreferenceViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.uuid-code">
      <Setter Property="FontFamily" Value="{DynamicResource CodeFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.uuid-code.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.uuid-status.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="6">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
    <ComboBox x:Name="RepresentationChoice" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" AutomationProperties.Name="{Binding Title}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:UuidRepresentationChoice">
          <TextBlock Text="{Binding Label}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <TextBlock Text="{local:Loc Key=uuidFourForms}" Classes="metadata" IsVisible="{Binding IsPreviewVisible}" />
    <TextBlock x:Name="HiddenPreviewHint" Text="{local:Loc Key=existingUuidHint}" Classes="metadata" TextWrapping="Wrap" IsVisible="{Binding !IsPreviewVisible}" />
    <Border Classes="card" Padding="10,6" IsVisible="{Binding IsPreviewVisible}">
      <ItemsControl x:Name="PreviewRows" ItemsSource="{Binding Preview}" AutomationProperties.Name="{local:Loc Key=uuidRepresentationsPreview}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:UuidPreviewRow">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,4">
              <TextBlock Grid.ColumnSpan="2" Text="{Binding Code}" Classes="uuid-code" Classes.selected="{Binding IsSelected}" />
              <TextBlock Grid.Row="1" Text="{Binding Details}" Classes="metadata" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Marker}" Classes="metadata" FontWeight="SemiBold" VerticalAlignment="Top" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <TextBlock Text="{local:Loc Key=uuidInvariant}" Classes="metadata" TextWrapping="Wrap" />
    <TextBlock x:Name="UuidStatus" Text="{Binding Status}" Classes="uuid-status" Classes.error="{Binding HasError}" TextWrapping="Wrap" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
