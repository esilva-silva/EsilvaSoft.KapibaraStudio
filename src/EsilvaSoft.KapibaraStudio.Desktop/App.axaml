<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:EsilvaSoft.KapibaraStudio.Desktop" xmlns:imaging="using:Avalonia.Media.Imaging" x:Class="EsilvaSoft.KapibaraStudio.Desktop.App" Name="{x:Static local:Branding.ProductName}" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Assets/Brand.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <imaging:Bitmap x:Key="BrandLogo">avares://EsilvaSoft.KapibaraStudio.Desktop/Assets/Branding/kapibara-logo-light.png</imaging:Bitmap>
          <SolidColorBrush x:Key="Syntax.Default">#162033</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Property">#075985</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.String">#166534</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Number">#92400E</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Boolean">#6D28D9</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Null">#7E22CE</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Identifier">#162033</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Keyword">#7E22CE</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Function">#075985</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Method">#075985</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Operator">#475569</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Punctuation">#475569</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Comment">#475569</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Regex">#9D174D</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoOperator">#9D174D</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoStage">#6D28D9</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoFunction">#854D0E</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoType">#0F766E</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Connection">#075985</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Database">#6D28D9</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Collection">#166534</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Index">#9A3412</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Error">#B91C1C</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Warning">#92400E</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Success">#166534</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.GhostText">#64748B</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MatchingBracket">#075985</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.UnmatchedBracket">#B91C1C</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.SearchMatch">#854D0E</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.AtlasSearchOperator">#9A3412</SolidColorBrush>
          <SolidColorBrush x:Key="BrandAccentBrush">#7357E8</SolidColorBrush>
          <SolidColorBrush x:Key="WorkspaceBackground">#F7F9FC</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryBackground">#EEF3F9</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryText">#162033</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryText">#475569</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#1B6EDC</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccentBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBrush">#D9EAFE</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBrush">#166534</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBrush">#92400E</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBrush">#B91C1C</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#CBD5E1</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorderBrush">#64748B</SolidColorBrush>
          <SolidColorBrush x:Key="HoverBrush">#E6EEF8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentHoverBrush">#155EC4</SolidColorBrush>
          <SolidColorBrush x:Key="AccentPressedBrush">#124FA6</SolidColorBrush>
          <SolidColorBrush x:Key="AgentAddedBackgroundBrush">#ECFDF3</SolidColorBrush>
          <SolidColorBrush x:Key="AgentAddedHoverBrush">#DCFCE7</SolidColorBrush>
          <SolidColorBrush x:Key="AgentAddedPressedBrush">#BBF7D0</SolidColorBrush>
          <SolidColorBrush x:Key="AgentRemovedBackgroundBrush">#FEF2F2</SolidColorBrush>
          <SolidColorBrush x:Key="AgentRemovedHoverBrush">#FEE2E2</SolidColorBrush>
          <SolidColorBrush x:Key="AgentRemovedPressedBrush">#FED8D8</SolidColorBrush>
          <SolidColorBrush x:Key="AgentApplyBackgroundBrush">#ECFDF3</SolidColorBrush>
          <SolidColorBrush x:Key="AgentApplyHoverBrush">#DCFCE7</SolidColorBrush>
          <SolidColorBrush x:Key="AgentApplyPressedBrush">#BBF7D0</SolidColorBrush>
          <SolidColorBrush x:Key="AgentReviewBackgroundBrush">#F7FAFF</SolidColorBrush>
          <SolidColorBrush x:Key="AgentReviewHoverBrush">#F4F9FF</SolidColorBrush>
          <SolidColorBrush x:Key="AgentReviewPressedBrush">#F3F8FF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <imaging:Bitmap x:Key="BrandLogo">avares://EsilvaSoft.KapibaraStudio.Desktop/Assets/Branding/kapibara-logo-dark.png</imaging:Bitmap>
          <SolidColorBrush x:Key="Syntax.Default">#F1F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Property">#7DD3FC</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.String">#86EFAC</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Number">#FCD34D</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Boolean">#C4B5FD</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Null">#D8B4FE</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Identifier">#F1F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Keyword">#D8B4FE</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Function">#7DD3FC</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Method">#7DD3FC</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Operator">#CBD5E1</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Punctuation">#CBD5E1</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Comment">#94A3B8</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Regex">#FDA4AF</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoOperator">#F9A8D4</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoStage">#C4B5FD</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoFunction">#FDE68A</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MongoType">#5EEAD4</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Connection">#7DD3FC</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Database">#C4B5FD</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Collection">#86EFAC</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Index">#FDBA74</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Error">#FB7185</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Warning">#FBBF24</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.Success">#3DDC97</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.GhostText">#94A3B8</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.MatchingBracket">#7DD3FC</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.UnmatchedBracket">#FB7185</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.SearchMatch">#FDE68A</SolidColorBrush>
          <SolidColorBrush x:Key="Syntax.AtlasSearchOperator">#FDBA74</SolidColorBrush>
          <SolidColorBrush x:Key="BrandAccentBrush">#9B7BFF</SolidColorBrush>
          <SolidColorBrush x:Key="WorkspaceBackground">#0B1020</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#151D2E</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryBackground">#111827</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryText">#F1F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryText">#94A3B8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#38A8FF</SolidColorBrush>
          <SolidColorBrush x:Key="OnAccentBrush">#0F172A</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBrush">#193B67</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBrush">#3DDC97</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBrush">#FBBF24</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorBrush">#FB7185</SolidColorBrush>
          <SolidColorBrush x:Key="DividerBrush">#334155</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorderBrush">#94A3B8</SolidColorBrush>
          <SolidColorBrush x:Key="HoverBrush">#26334A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentHoverBrush">#60B9FF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentPressedBrush">#2589E8</SolidColorBrush>
          <SolidColorBrush x:Key="AgentAddedBackgroundBrush">#123222</SolidColorBrush>
          <SolidColorBrush x:Key="AgentAddedHoverBrush">#19432D</SolidColorBrush>
          <SolidColorBrush x:Key="AgentAddedPressedBrush">#205539</SolidColorBrush>
          <SolidColorBrush x:Key="AgentRemovedBackgroundBrush">#3A1B24</SolidColorBrush>
          <SolidColorBrush x:Key="AgentRemovedHoverBrush">#4B202B</SolidColorBrush>
          <SolidColorBrush x:Key="AgentRemovedPressedBrush">#44202B</SolidColorBrush>
          <SolidColorBrush x:Key="AgentApplyBackgroundBrush">#123222</SolidColorBrush>
          <SolidColorBrush x:Key="AgentApplyHoverBrush">#19432D</SolidColorBrush>
          <SolidColorBrush x:Key="AgentApplyPressedBrush">#205539</SolidColorBrush>
          <SolidColorBrush x:Key="AgentReviewBackgroundBrush">#122842</SolidColorBrush>
          <SolidColorBrush x:Key="AgentReviewHoverBrush">#173451</SolidColorBrush>
          <SolidColorBrush x:Key="AgentReviewPressedBrush">#16314E</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="InterfaceFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <FontFamily x:Key="CodeFont">Cascadia Mono, JetBrains Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#1B6EDC" RegionColor="#F7F9FC" ErrorText="#B91C1C" />
        <ColorPaletteResources x:Key="Dark" Accent="#38A8FF" RegionColor="#0B1020" ErrorText="#FB7185" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/kapibara-studio.ico" />
      <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource WorkspaceBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Button:disabled Path.command-icon">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
    </Style>
    <Style Selector="Path.command-icon">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
      <Setter Property="StrokeThickness" Value="1.75" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <Style Selector="Button.agent-apply">
      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="Background" Value="{DynamicResource AgentApplyBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.agent-apply:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgentApplyHoverBrush}" />
    </Style>
    <Style Selector="Button.agent-apply:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgentApplyPressedBrush}" />
    </Style>
    <Style Selector="Button.agent-apply:disabled">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.agent-review">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AgentReviewBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.agent-review:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgentReviewHoverBrush}" />
    </Style>
    <Style Selector="Button.agent-review:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AgentReviewPressedBrush}" />
    </Style>
    <!-- Narrow windows keep the icon; tooltip and accessible name still carry the text. -->
    <Style Selector="Button.compact TextBlock.command-label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <Style Selector="TextBlock.metadata">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource PrimaryText}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="TextBox:not(:disabled) /template/ TextBlock#PART_Placeholder">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.metadata">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="PlaceholderForeground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <!-- Two-option segmented choice: the checked option has border and weight, not color alone. -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:focus-visible /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TreeView.results">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.notice">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <Style Selector="TextBlock.result-value">
      <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    </Style>
    <Style Selector="Border.type-chip">
      <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TreeViewItem:selected TextBlock.metadata, TreeViewItem:selected TextBlock.notice">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
    </Style>
    <Style Selector="TextBlock.menu-caption">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="/SyntaxHighlighting/SyntaxEditor.axaml" />
  </Application.Styles>
</Application>
