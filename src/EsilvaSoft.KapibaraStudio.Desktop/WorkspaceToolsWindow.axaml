<Window xmlns="https://github.com/avaloniaui" xmlns:syntax="using:EsilvaSoft.KapibaraStudio.Desktop.SyntaxHighlighting" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.KapibaraStudio.Desktop.ViewModels" xmlns:local="using:EsilvaSoft.KapibaraStudio.Desktop" x:Class="EsilvaSoft.KapibaraStudio.Desktop.WorkspaceToolsWindow" x:DataType="vm:MainWindowViewModel" Title="{local:Loc Key=toolsTitle}" Width="1100" Height="740" MinWidth="800" MinHeight="540">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="8">
    <StackPanel>
      <TextBlock Text="{local:Loc Key=toolsTitle}" Classes="section-title"/>
      <TextBlock Text="{Binding SelectedProfileDetails}" Classes="muted"/>
      <TextBlock Text="{Binding SelectedDatabase}" FontWeight="SemiBold"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <TabControl MinWidth="760" MinHeight="520">
        <TabItem Header="{local:Loc Key=toolsQuerySchema}">
          <StackPanel Spacing="12" Margin="12">
            <TextBlock Text="{local:Loc Key=filterExtendedJson}"/>
            <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Text="{Binding QueryFilter}" Classes="code syntax" AcceptsReturn="True" MinHeight="96"/>
            <WrapPanel>
              <Button Content="{local:Loc Key=explainExecutionStats}" Command="{Binding ExplainQueryCommand}"/>
              <Button Content="{local:Loc Key=exactCountButton}" Command="{Binding CountExactDocumentsCommand}"/>
              <Button Content="{local:Loc Key=estimateCollection}" Command="{Binding CountEstimatedDocumentsCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding CountResults}" TextWrapping="Wrap"/>
            <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Text="{Binding ExplainResults}" Classes="code syntax" IsReadOnly="True" AcceptsReturn="True" Height="180" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="{local:Loc Key=schemaSampleDocuments}"/>
            <NumericUpDown Value="{Binding SchemaSampleMaximumDocuments}" Minimum="1" Maximum="1000" Width="150" HorizontalAlignment="Left"/>
            <WrapPanel>
              <Button Content="{local:Loc Key=sampleFields}" Command="{Binding SampleSchemaFieldsCommand}"/>
              <Button Content="{local:Loc Key=inferValidator}" Command="{Binding InferCollectionValidatorCommand}"/>
              <Button Content="{local:Loc Key=suggestMql}" Command="{Binding SuggestMqlCommand}"/>
            </WrapPanel>
            <TextBlock Text="{Binding AutocompleteSuggestions}" TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding QuerySuggestions}" SelectedItem="{Binding SelectedQuerySuggestion}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="{local:Loc Key=applySuggestion}" Command="{Binding ApplyQuerySuggestionCommand}"/>
            <TextBlock Text="{local:Loc Key=inferredValidatorNote}"/>
            <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Text="{Binding CollectionValidatorJson}" Classes="code syntax" AcceptsReturn="True" Height="160" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="{local:Loc Key=toolsAnalysis}">
          <TabControl>
            <TabItem Header="{local:Loc Key=toolsDistinctValues}">
              <Grid Margin="8" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{local:Loc Key=field}" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding DistinctField}" Width="280" PlaceholderText="{local:Loc Key=distinctFieldPlaceholder}"/>
                  <TextBlock Text="{local:Loc Key=maximum}" VerticalAlignment="Center"/>
                  <NumericUpDown Minimum="1" Maximum="10000" Value="{Binding DistinctMaximumValues}" Width="110"/>
                  <Button Content="{local:Loc Key=distinctSearch}" Command="{Binding GetDistinctValuesCommand}" IsEnabled="{Binding CanGetDistinctValues}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{local:Loc Key=distinctNote}" TextWrapping="Wrap" Opacity="0.75"/>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Grid.Row="2" Classes="code syntax" Text="{Binding DistinctResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </Grid>
            </TabItem>
            <TabItem Header="{local:Loc Key=toolsExplain}">
              <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="{local:Loc Key=explainPlanReadOnly}" FontSize="16" FontWeight="SemiBold"/>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Grid.Row="1" Classes="code syntax" Text="{Binding ExplainResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </Grid>
            </TabItem>
            <TabItem Header="{local:Loc Key=toolsAggregations}">
              <Grid Margin="8" RowDefinitions="Auto,*,Auto,*" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{local:Loc Key=limit}" VerticalAlignment="Center"/>
                  <NumericUpDown Minimum="1" Maximum="10000" Value="{Binding AggregationLimit}" Width="110"/>
                  <Button Content="{local:Loc Key=suggestStages}" Command="{Binding SuggestAggregationCommand}"/>
                  <Button Content="{local:Loc Key=executePipeline}" Command="{Binding ExecuteAggregationCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                </StackPanel>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Aggregation" Classes="syntax" Grid.Row="1" Text="{Binding AggregationPipeline}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}" PlaceholderText="{local:Loc Key=pipelineJsonExample}"/>
                <TextBlock Grid.Row="2" Text="{local:Loc Key=pipelineResult}" FontWeight="SemiBold"/>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="3" Text="{Binding AggregationResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
              </Grid>
            </TabItem>
          </TabControl>
        </TabItem>
        <TabItem Header="{local:Loc Key=toolsOperationsData}">
          <TabControl>
            <TabItem Header="{local:Loc Key=toolsTransfer}">
              <Grid Margin="8" RowDefinitions="Auto,Auto,*,Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="{local:Loc Key=exportNote}" TextWrapping="Wrap" Opacity="0.8"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{local:Loc Key=perCollectionLimit}" VerticalAlignment="Center"/>
                  <NumericUpDown Minimum="1" Maximum="1000000" Value="{Binding ExportDocumentsPerCollectionLimit}" Width="130"/>
                  <Button Content="{local:Loc Key=exportSelectedDatabase}" Command="{Binding ExportDatabaseCommand}" IsEnabled="{Binding CanExportDatabase}"/>
                </StackPanel>
                <TextBox Grid.Row="2" Text="{Binding ExportResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
                <TextBlock Grid.Row="3" Text="{local:Loc Key=importNote}" TextWrapping="Wrap" Opacity="0.8"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding ImportSourceDirectory}" Width="460" PlaceholderText="{local:Loc Key=importFolderPlaceholder}"/>
                  <Button Content="{local:Loc Key=chooseFolder}" Click="SelectImportDirectory"/>
                  <Button Content="{local:Loc Key=importSelectedDatabase}" Command="{Binding ImportDatabaseCommand}" IsEnabled="{Binding CanImportDatabase}"/>
                </StackPanel>
                <TextBox Grid.Row="5" Text="{Binding ImportResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
              </Grid>
            </TabItem>
            <TabItem Header="{local:Loc Key=toolsAdministration}">
              <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{local:Loc Key=serverStatus}" Command="{Binding LoadServerStatusCommand}" IsEnabled="{Binding HasSelectedProfile}"/>
                  <Button Content="{local:Loc Key=topology}" Command="{Binding LoadTopologyCommand}" IsEnabled="{Binding HasSelectedProfile}"/>
                  <Button Content="{local:Loc Key=currentOperations}" Command="{Binding LoadCurrentOperationsCommand}" IsEnabled="{Binding HasSelectedProfile}"/>
                  <Button Content="{local:Loc Key=currentProfiler}" Command="{Binding LoadProfilerStatusCommand}" IsEnabled="{Binding CanLoadDatabaseStats}"/>
                  <Button Content="{local:Loc Key=users}" Command="{Binding LoadUsersCommand}" IsEnabled="{Binding HasSelectedProfile}"/>
                  <Button Content="{local:Loc Key=roles}" Command="{Binding LoadRolesCommand}" IsEnabled="{Binding HasSelectedProfile}"/>
                  <Button Content="{local:Loc Key=localAudit}" Command="{Binding LoadAuditCommand}"/>
                  <TextBox Text="{Binding AuditExportPath}" Width="220" PlaceholderText="{local:Loc Key=auditJsonFile}"/>
                  <Button Content="{local:Loc Key=exportAudit}" Command="{Binding ExportAuditCommand}"/>
                  <Button Content="{local:Loc Key=databaseStats}" Command="{Binding LoadDatabaseStatsCommand}" IsEnabled="{Binding CanLoadDatabaseStats}"/>
                  <Button Content="{local:Loc Key=collectionStats}" Command="{Binding LoadCollectionStatsCommand}" IsEnabled="{Binding CanLoadCollectionStats}"/>
                  <TextBlock Text="{local:Loc Key=privilegesNote}" VerticalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding OperationIdToKill}" Width="180" PlaceholderText="{local:Loc Key=numericOperationId}"/>
                  <TextBox Text="{Binding OperationKillConfirmation}" Width="180" PlaceholderText="{local:Loc Key=repeatId}"/>
                  <Button Content="{local:Loc Key=interruptOperation}" Classes="danger" Command="{Binding KillOperationCommand}" IsEnabled="{Binding CanKillOperation}"/>
                  <TextBlock Text="{local:Loc Key=interruptionIrreversible}" VerticalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="5">
                  <TextBox Text="{Binding DropDatabaseConfirmation}" Width="260" PlaceholderText="{local:Loc Key=selectedDatabaseName}"/>
                  <Button Grid.Column="1" Content="{local:Loc Key=dropDatabase}" Classes="danger" Command="{Binding DropDatabaseCommand}" IsEnabled="{Binding CanDropDatabase}"/>
                  <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{local:Loc Key=protectedDatabases}" VerticalAlignment="Center" Opacity="0.7"/>
                  <TextBox Grid.Row="1" Text="{Binding NewDatabaseName}" PlaceholderText="{local:Loc Key=newDatabase}"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewDatabaseInitialCollection}" PlaceholderText="{local:Loc Key=initialCollection}"/>
                  <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewDatabaseConfirmation}" PlaceholderText="{local:Loc Key=repeatDatabase}"/>
                  <Button Grid.Row="1" Grid.Column="3" Content="{local:Loc Key=createDatabase}" Command="{Binding CreateDatabaseCommand}" IsEnabled="{Binding CanCreateDatabase}"/>
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding CollectionIntegrityConfirmation}" Width="260" PlaceholderText="{local:Loc Key=selectedCollectionValidation}"/>
                  <Button Content="{local:Loc Key=validateIntegrity}" Command="{Binding ValidateCollectionIntegrityCommand}" IsEnabled="{Binding CanValidateCollectionIntegrity}"/>
                  <TextBlock Text="{local:Loc Key=validationMayTake}" VerticalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding CollectionCompactConfirmation}" Width="260" PlaceholderText="{local:Loc Key=selectedCollectionCompact}"/>
                  <CheckBox Content="{local:Loc Key=force}" IsChecked="{Binding CollectionCompactForce}" VerticalAlignment="Center"/>
                  <Button Content="{local:Loc Key=compactCollection}" Classes="danger" Command="{Binding CompactCollectionCommand}" IsEnabled="{Binding CanCompactCollection}"/>
                  <TextBlock Text="{local:Loc Key=topologyUnavailable}" VerticalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
                <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="5">
                  <TextBox Text="{Binding NewDatabaseUsername}" PlaceholderText="{local:Loc Key=newUser}"/>
                  <TextBox Grid.Column="1" PasswordChar="●" Text="{Binding NewDatabaseUserPassword}" PlaceholderText="{local:Loc Key=passwordNotPersisted}"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Column="2" Text="{Binding NewDatabaseUserRoles}" PlaceholderText="{local:Loc Key=rolesJson}" FontFamily="{DynamicResource CodeFont}"/>
                  <TextBox Grid.Column="3" Text="{Binding NewDatabaseUserConfirmation}" PlaceholderText="{local:Loc Key=repeatUser}"/>
                  <Button Grid.Column="4" Content="{local:Loc Key=createUser}" Command="{Binding CreateDatabaseUserCommand}" IsEnabled="{Binding CanCreateDatabaseUser}"/>
                  <TextBox Grid.Row="1" Text="{Binding DatabaseUsernameToDrop}" PlaceholderText="{local:Loc Key=userToRemove}"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseUserDropConfirmation}" PlaceholderText="{local:Loc Key=repeatUser}"/>
                  <Button Grid.Row="1" Grid.Column="2" Content="{local:Loc Key=removeUser}" Classes="danger" Command="{Binding DropDatabaseUserCommand}" IsEnabled="{Binding CanDropDatabaseUser}"/>
                  <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Text="{local:Loc Key=removalIrreversible}" VerticalAlignment="Center" Opacity="0.7"/>
                  <TextBox Grid.Row="2" Text="{Binding DatabaseRoleUsername}" PlaceholderText="{local:Loc Key=userForRoles}"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseRolePayload}" PlaceholderText="{local:Loc Key=rolesJson}" FontFamily="{DynamicResource CodeFont}"/>
                  <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding DatabaseRoleConfirmation}" PlaceholderText="{local:Loc Key=repeatUser}"/>
                  <CheckBox Grid.Row="2" Grid.Column="3" Content="{local:Loc Key=revoke}" IsChecked="{Binding RevokeDatabaseRoles}" VerticalAlignment="Center"/>
                  <Button Grid.Row="2" Grid.Column="4" Content="{local:Loc Key=updateRoles}" Command="{Binding UpdateDatabaseUserRolesCommand}" IsEnabled="{Binding CanUpdateDatabaseUserRoles}"/>
                </Grid>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="6" Text="{Binding AdministrationResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
              </Grid>
            </TabItem>
            <TabItem Header="{local:Loc Key=toolsDocuments}">
              <Grid Margin="8" ColumnDefinitions="*,10,*">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                  <TextBlock Text="{local:Loc Key=documentExtendedJsonInsertReplace}" FontWeight="SemiBold"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="1" Text="{Binding DocumentJson}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="{local:Loc Key=insert}" Command="{Binding InsertDocumentCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                    <Button Content="{local:Loc Key=replaceByFilter}" Click="ConfirmDestructive" Tag="ReplaceDocumentCommand" IsEnabled="{Binding CanExecuteQuery}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="3" Text="{local:Loc Key=partialUpdateNote}" TextWrapping="Wrap" Opacity="0.7"/>
                  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="{local:Loc Key=generateIdentifier}" Command="{Binding GenerateIdentifierCommand}"/>
                    <TextBlock Text="{Binding IdentifierLabel}" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding IdentifierLabel}"/>
                  </StackPanel>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="5" Text="{Binding IdentifierSnippet}" IsReadOnly="True" FontFamily="{DynamicResource CodeFont}" AutomationProperties.Name="{local:Loc Key=identifierConstructor}"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="6" Text="{Binding IdentifierExtendedJsonSnippet}" IsReadOnly="True" FontFamily="{DynamicResource CodeFont}" AutomationProperties.Name="{local:Loc Key=identifierCanonical}"/>
                  <Grid Grid.Row="7" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding IdentifierInput}" PlaceholderText="{local:Loc Key=identifierInputPlaceholder}" FontFamily="{DynamicResource CodeFont}" AutomationProperties.Name="{local:Loc Key=identifierToInterpret}"/>
                    <Button Grid.Column="1" Content="{local:Loc Key=interpret}" Command="{Binding InterpretIdentifierCommand}"/>
                  </Grid>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="8" Text="{Binding IdentifierInterpretation}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource CodeFont}" AutomationProperties.Name="{local:Loc Key=interpretedIdentifier}"/>
                </Grid>
                <GridSplitter Grid.Column="1" Width="10"/>
                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,120,Auto,120" RowSpacing="8">
                  <TextBlock Text="{local:Loc Key=requiredMutationFilter}" FontWeight="SemiBold"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="1" Text="{Binding MutationFilter}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="2" Text="{Binding UpdateJson}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}" PlaceholderText="{local:Loc Key=updateJsonExample}"/>
                  <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="{local:Loc Key=loadPreview}" Command="{Binding PreviewDocumentCommand}" IsEnabled="{Binding CanPreviewDocument}"/>
                    <Button Content="{local:Loc Key=duplicatePreview}" Command="{Binding DuplicatePreviewDocumentCommand}" IsEnabled="{Binding CanDuplicatePreviewDocument}"/>
                    <Button Content="{local:Loc Key=updateFields}" Command="{Binding UpdateDocumentCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                    <Button Content="{local:Loc Key=findAndModify}" Command="{Binding FindAndModifyCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                    <CheckBox Content="{local:Loc Key=upsert}" IsChecked="{Binding UpdateUpsert}"/>
                    <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Text="{Binding UpdateArrayFiltersJson}" Width="280" PlaceholderText="{local:Loc Key=arrayFiltersOptional}" FontFamily="{DynamicResource CodeFont}"/>
                  </StackPanel>
                  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="{local:Loc Key=deleteByFilter}" Classes="danger" Click="ConfirmDestructive" Tag="DeleteDocumentCommand" IsEnabled="{Binding CanExecuteQuery}"/>
                    <CheckBox Content="{local:Loc Key=deleteAllMatches}" IsChecked="{Binding DeleteManyDocuments}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Text="{local:Loc Key=firstMatchedPreview}" FontWeight="SemiBold"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="6" Text="{Binding DocumentPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
                  <TextBlock Grid.Row="7" Text="{local:Loc Key=afterFindModify}" FontWeight="SemiBold"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="8" Text="{Binding FindAndModifyResult}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="{local:Loc Key=toolsBulkCrud}">
              <Grid Margin="8" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{local:Loc Key=bulkDocuments}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  <TextBlock Text="{local:Loc Key=maximum}" VerticalAlignment="Center"/>
                  <NumericUpDown Minimum="1" Maximum="10000" Value="{Binding BulkMaximumDocuments}" Width="100"/>
                  <CheckBox Content="{local:Loc Key=ordered}" IsChecked="{Binding BulkOrdered}"/>
                  <Button Content="{local:Loc Key=insert}" Command="{Binding InsertManyDocumentsCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                </StackPanel>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="1" Text="{Binding BulkDocumentsJson}" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}" PlaceholderText="[ { &quot;campo&quot;: &quot;valor&quot; } ]"/>
                <TextBlock Grid.Row="2" Text="{local:Loc Key=bulkNote}" Opacity="0.7"/>
              </Grid>
            </TabItem>
            <TabItem Header="{local:Loc Key=toolsIndexes}">
              <Grid Margin="8" ColumnDefinitions="*,10,*">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                  <TextBlock Text="{local:Loc Key=indexKeys}" FontWeight="SemiBold"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="1" Text="{Binding IndexKeys}" FontFamily="{DynamicResource CodeFont}"/>
                  <TextBox Grid.Row="2" Text="{Binding IndexName}" PlaceholderText="{local:Loc Key=optionalName}"/>
                  <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="{local:Loc Key=unique}" IsChecked="{Binding IndexIsUnique}"/>
                    <CheckBox Content="{local:Loc Key=sparse}" IsChecked="{Binding IndexIsSparse}"/>
                    <CheckBox Content="{local:Loc Key=hidden}" IsChecked="{Binding IndexIsHidden}"/>
                    <TextBlock Text="{local:Loc Key=ttlSeconds}" VerticalAlignment="Center"/>
                    <NumericUpDown Minimum="0" Maximum="2147483647" Value="{Binding IndexExpireAfterSeconds}" Width="150"/>
                  </StackPanel>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="4" Text="{Binding IndexPartialFilter}" PlaceholderText="{local:Loc Key=partialFilter}" FontFamily="{DynamicResource CodeFont}"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="5" Text="{Binding IndexCollation}" PlaceholderText="{local:Loc Key=collationOptional}" FontFamily="{DynamicResource CodeFont}"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="6" Text="{Binding IndexWildcardProjection}" PlaceholderText="{local:Loc Key=wildcardProjection}" FontFamily="{DynamicResource CodeFont}"/>
                  <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8">
                    <Button Content="{local:Loc Key=createIndex}" Command="{Binding CreateIndexCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                    <Button Content="{local:Loc Key=updateList}" Command="{Binding LoadIndexesCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                    <Button Content="{local:Loc Key=indexUsage}" Command="{Binding LoadIndexUsageStatsCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                  </StackPanel>
                  <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding IndexNameToDrop}" Width="220" PlaceholderText="{local:Loc Key=dropIndexName}"/>
                    <Button Content="{local:Loc Key=removeIndex}" Classes="danger" Click="ConfirmDestructive" Tag="DropIndexCommand" IsEnabled="{Binding CanDropIndex}"/>
                    <TextBox Text="{Binding IndexNameForVisibility}" Width="180" PlaceholderText="{local:Loc Key=indexVisibility}"/>
                    <TextBox Text="{Binding IndexVisibilityConfirmation}" Width="160" PlaceholderText="{local:Loc Key=repeatIndex}"/>
                    <CheckBox Content="{local:Loc Key=hidden}" IsChecked="{Binding IndexVisibilityHidden}"/>
                    <Button Content="{local:Loc Key=changeVisibility}" Command="{Binding SetIndexVisibilityCommand}" IsEnabled="{Binding CanSetIndexVisibility}"/>
                    <TextBlock Text="{local:Loc Key=protectedId}" VerticalAlignment="Center" Opacity="0.7"/>
                  </StackPanel>
                </Grid>
                <GridSplitter Grid.Column="1" Width="10"/>
                <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBlock Text="{local:Loc Key=indexesOnServer}" FontWeight="SemiBold"/>
                  <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Grid.Row="1" Text="{Binding IndexResults}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource CodeFont}"/>
                </Grid>
              </Grid>
            </TabItem>
          </TabControl>
        </TabItem>
        <TabItem Header="{local:Loc Key=toolsCollections}">
          <Expander Header="{local:Loc Key=collectionManager}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding NewCollectionName}" Width="220" PlaceholderText="{local:Loc Key=newCollectionName}"/>
                <CheckBox Content="{local:Loc Key=cappedCollection}" IsChecked="{Binding NewCollectionIsCapped}" VerticalAlignment="Center"/>
                <CheckBox Content="{local:Loc Key=viewCollection}" IsChecked="{Binding NewCollectionIsView}" VerticalAlignment="Center"/>
                <CheckBox Content="{local:Loc Key=clusteredCollection}" IsChecked="{Binding NewCollectionIsClustered}" VerticalAlignment="Center"/>
                <TextBlock Text="{local:Loc Key=maxBytes}" VerticalAlignment="Center"/>
                <NumericUpDown Minimum="1" Maximum="1099511627776" Value="{Binding NewCollectionMaxSizeBytes}" Width="145"/>
                <TextBlock Text="{local:Loc Key=maxDocs}" VerticalAlignment="Center"/>
                <NumericUpDown Minimum="1" Maximum="1000000000" Value="{Binding NewCollectionMaxDocuments}" Width="120"/>
                <Button Content="{local:Loc Key=createCollection}" Command="{Binding CreateCollectionCommand}" IsEnabled="{Binding CanCreateCollection}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding NewCollectionViewOn}" Width="220" PlaceholderText="{local:Loc Key=viewSource}"/>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Aggregation" Classes="syntax" Text="{Binding NewCollectionViewPipeline}" Width="430" PlaceholderText="{local:Loc Key=viewPipeline}" FontFamily="{DynamicResource CodeFont}"/>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Text="{Binding NewCollectionCollation}" Width="250" PlaceholderText="{local:Loc Key=collationBsonOptional}" FontFamily="{DynamicResource CodeFont}"/>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Text="{Binding NewCollectionClusteredIndexKey}" Width="180" PlaceholderText="{local:Loc Key=clusteredKey}" FontFamily="{DynamicResource CodeFont}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding RenameCollectionName}" Width="220" PlaceholderText="{local:Loc Key=renameCollectionName}"/>
                <CheckBox Content="{local:Loc Key=replaceDestination}" IsChecked="{Binding RenameDropTarget}" VerticalAlignment="Center"/>
                <Button Content="{local:Loc Key=renameCollection}" Command="{Binding RenameCollectionCommand}" IsEnabled="{Binding CanRenameCollection}"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Aggregation" Classes="syntax" Text="{Binding ViewUpdatePipeline}" Width="430" PlaceholderText="{local:Loc Key=viewPipeline}" FontFamily="{DynamicResource CodeFont}"/>
                <TextBox Text="{Binding ViewUpdateConfirmation}" Width="200" PlaceholderText="{local:Loc Key=selectedView}"/>
                <Button Content="{local:Loc Key=updateView}" Command="{Binding UpdateViewCommand}" IsEnabled="{Binding CanUpdateView}"/>
              </StackPanel>
              <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                <Button Content="{local:Loc Key=loadValidation}" Command="{Binding LoadCollectionValidationCommand}" IsEnabled="{Binding CanExecuteQuery}"/>
                <syntax:MongoTextEditor syntax:SyntaxSettings.Language="Json" Classes="syntax" Text="{Binding CollectionValidatorJson}" Width="430" PlaceholderText="{local:Loc Key=validatorJson}" FontFamily="{DynamicResource CodeFont}"/>
                <ComboBox ItemsSource="{Binding CollectionValidationLevels}" SelectedItem="{Binding CollectionValidationLevel}" Width="105"/>
                <ComboBox ItemsSource="{Binding CollectionValidationActions}" SelectedItem="{Binding CollectionValidationAction}" Width="90"/>
                <TextBox Text="{Binding CollectionValidationConfirmation}" Width="200" PlaceholderText="{local:Loc Key=selectedCollection}"/>
                <Button Content="{local:Loc Key=applyValidation}" Command="{Binding ConfigureCollectionValidationCommand}" IsEnabled="{Binding CanConfigureCollectionValidation}"/>
              </StackPanel>
              <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{local:Loc Key=removeCollectionLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Text="{Binding DropCollectionConfirmation}" Width="220" PlaceholderText="{local:Loc Key=selectedCollection}"/>
                <Button Content="{local:Loc Key=removeCollection}" Classes="danger" Command="{Binding DropCollectionCommand}" IsEnabled="{Binding CanDropCollection}" ToolTip.Tip="{local:Loc Key=removeCollectionTooltip}"/>
              </StackPanel>
            </Grid>
          </Expander>
        </TabItem>
      </TabControl>
    </ScrollViewer>
    <DockPanel Grid.Row="2">
      <Button DockPanel.Dock="Right" Content="{local:Loc Key=cancelOperation}" Command="{Binding CancelOperationCommand}"/>
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</Window>
