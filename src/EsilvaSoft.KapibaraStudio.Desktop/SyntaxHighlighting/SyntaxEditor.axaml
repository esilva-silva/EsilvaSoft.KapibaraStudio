<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:edit="using:AvaloniaEdit">
  <Style Selector="edit|TextEditor.syntax">
    <Setter Property="FontFamily" Value="{DynamicResource CodeFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Syntax.Default}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="edit|TextEditor.syntax:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
  </Style>
</Styles>
