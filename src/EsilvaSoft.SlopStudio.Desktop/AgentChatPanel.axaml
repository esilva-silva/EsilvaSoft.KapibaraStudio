<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.SlopStudio.Desktop.ViewModels" xmlns:local="using:EsilvaSoft.SlopStudio.Desktop" x:Class="EsilvaSoft.SlopStudio.Desktop.AgentChatPanel" x:DataType="vm:AgentChatViewModel" x:CompileBindings="True" MinWidth="320" AutomationProperties.Name="{local:Loc Key=agentPanelTitle}">
  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="ListBox#History > ListBoxItem">
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox#History > ListBoxItem:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.agent-message">
      <Setter Property="Background" Value="{DynamicResource SecondaryBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.agent-message.user">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Chips of the panel: HoverBrush + DividerBrush outline keep the chip visible on PanelBackground in both themes
         (SecondaryBackground is almost the panel color in the dark theme). -->
    <Style Selector="Border.type-chip">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.read-notice">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.agent-approval">
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Margin="12">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="{local:Loc Key=agentPanelTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" x:Name="HistoryButton" Content="◷" Classes="quiet" Padding="6,2" MinWidth="28" ToolTip.Tip="{local:Loc Key=agentHistory}" Click="ShowHistory" AutomationProperties.Name="{local:Loc Key=agentHistory}">
            <Button.Flyout><Flyout><StackPanel Width="340" Spacing="6" Margin="8"><TextBox Text="{Binding HistorySearch}" PlaceholderText="{local:Loc Key=agentHistorySearch}"/><TextBlock Text="{Binding HistoryStatus}" Classes="metadata" TextWrapping="Wrap"/><ScrollViewer MaxHeight="360"><ItemsControl ItemsSource="{Binding HistoryItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AgentHistoryItemViewModel"><StackPanel Spacing="3"><Button Content="{Binding DisplayTitle}" HorizontalContentAlignment="Left" Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).OpenHistoryItemCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsReadable}"/><TextBlock Text="{Binding MetaText}" Classes="metadata"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Content="{local:Loc Key=agentHistoryDelete}" Command="{Binding BeginDeleteCommand}" IsVisible="{Binding IsIdle}"/><TextBlock Text="{local:Loc Key=agentHistoryConfirmDelete}" IsVisible="{Binding IsConfirmingDelete}"/><Button Content="{local:Loc Key=cancel}" Command="{Binding CancelDeleteCommand}" IsVisible="{Binding IsConfirmingDelete}"/><Button Content="{local:Loc Key=delete}" Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).ConfirmDeleteCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsConfirmingDelete}"/></StackPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Flyout></Button.Flyout>
          </Button>
          <Button Grid.Column="2" Classes="quiet" Content="＋" Padding="6,2" MinWidth="28" ToolTip.Tip="{local:Loc Key=agentNewConversation}" Command="{Binding NewConversationCommand}" AutomationProperties.Name="{local:Loc Key=agentNewConversation}" />
          <Button Grid.Column="3" x:Name="ConfigureButton" Classes="quiet" Content="⚙" Padding="6,2" MinWidth="28" ToolTip.Tip="{local:Loc Key=agentConfigure}" Command="{Binding ConfigureCommand}" AutomationProperties.Name="{local:Loc Key=agentConfigure}" />
          <Button Grid.Column="4" x:Name="ClosePanelButton" Content="×" Classes="quiet" Padding="8,0" MinWidth="32" IsVisible="False" Click="OnClosePanelClick" />
        </Grid>
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding SelectedProvider, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Border Classes="type-chip" Margin="0,0,6,0" ToolTip.Tip="{Binding DestinationHint}">
            <TextBlock x:Name="DestinationBadge" Text="{Binding DestinationText}" Classes="metadata" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" />
          </Border>
          <Border Classes="type-chip" IsVisible="{Binding HasModeText}" ToolTip.Tip="{local:Loc Key=agentModeChipHint}">
            <TextBlock x:Name="ModeBadge" Text="{Binding ModeText}" Classes="metadata" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" AutomationProperties.Name="{Binding ModeText}" />
          </Border>
        </WrapPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <ComboBox x:Name="ProviderSelector" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" IsEnabled="{Binding CanChangeProvider}" PlaceholderText="{local:Loc Key=agentProvider}" AutomationProperties.Name="{local:Loc Key=agentProvider}" ToolTip.Tip="{local:Loc Key=agentProvider}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentProviderOption">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="type-chip" IsVisible="{Binding HasModeText}">
                    <TextBlock Text="{Binding ModeText}" Classes="metadata" Foreground="{DynamicResource PrimaryText}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <!-- The closed box shows only the name (the mode chip sits right above it); the list shows name + chip. -->
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:AgentProviderOption">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="1" x:Name="ModelSelector" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsVisible="{Binding HasModels}" IsEnabled="{Binding CanChangeProvider}" AutomationProperties.Name="{local:Loc Key=agentModel}" ToolTip.Tip="{local:Loc Key=agentModel}" />
        </Grid>
        <ComboBox x:Name="ModeSelector" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{local:Loc Key=agentModeOperation}" ToolTip.Tip="{Binding SelectedModeHint}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AgentModeOption"><TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Hint}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ItemsControl x:Name="ContextChips" ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AgentContextChipViewModel"><Border Classes="type-chip" Margin="0,0,4,4" Padding="5,2" ToolTip.Tip="{Binding Tooltip}"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding Label}" Classes="metadata" Foreground="{DynamicResource PrimaryText}" TextTrimming="CharacterEllipsis" MaxWidth="210"/><Button Content="×" Padding="2,0" MinWidth="24" Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).RemoveChipCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding RemoveLabel}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="TabContextText" Text="{Binding PermissionsSummary}" Classes="metadata" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PermissionsSummary}" />
        <Border x:Name="ReadScopeNotice" Classes="read-notice" IsVisible="{Binding HasReadScope}">
          <TextBlock Text="{Binding ReadScopeText}" Classes="metadata" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" MaxLines="8" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReadScopeText}" AutomationProperties.Name="{Binding ReadScopeText}" />
        </Border>
      </StackPanel>
      <Border Grid.Row="1" Classes="card" Padding="8,6">
        <StackPanel Spacing="6">
          <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" TextWrapping="Wrap" Classes.error="{Binding IsStatusError}" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="RetryAvailabilityButton" HorizontalAlignment="Right" Content="{Binding AvailabilityActionText}" Command="{Binding RetryAvailabilityCommand}" IsVisible="{Binding ShowAvailabilityRetry}" ToolTip.Tip="{local:Loc Key=agentRefreshProvidersHint}" />
          <Button x:Name="RefreshProvidersButton" HorizontalAlignment="Right" Content="{local:Loc Key=agentRefreshProviders}" Command="{Binding RefreshProvidersCommand}" IsVisible="{Binding ShowRefreshProviders}" ToolTip.Tip="{local:Loc Key=agentRefreshProvidersHint}" AutomationProperties.Name="{local:Loc Key=agentRefreshProviders}" AutomationProperties.HelpText="{local:Loc Key=agentRefreshProvidersHint}" />
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" MinHeight="96">
        <ListBox x:Name="History" ItemsSource="{Binding Items}" AutomationProperties.Name="{local:Loc Key=agentHistory}" Background="{DynamicResource WorkspaceBackground}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:AgentChatMessageItem">
              <Border Classes="agent-message" Classes.user="{Binding IsUser}">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding RoleLabel}" Classes="metadata" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StreamingLabel}" Classes="metadata" IsVisible="{Binding IsStreaming}" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentToolCallItem">
              <Border Classes="card" Padding="8,6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                  <TextBlock Text="{Binding OriginText}" Classes="metadata" TextWrapping="Wrap" IsVisible="{Binding HasOriginText}" />
                  <TextBlock Text="{Binding StatusText}" Classes="metadata" Classes.error="{Binding IsError}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentApprovalCardItem">
              <Border Classes="card agent-approval" Padding="8,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Classes="metadata" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding ReviewLabel}" IsVisible="{Binding IsPending}" Command="{Binding $parent[ListBox].((vm:AgentChatViewModel)DataContext).OpenApprovalCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding ReviewLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentEditProposalCardItem">
              <Border Classes="card" Padding="8" Margin="2">
                <StackPanel Spacing="5">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CountsText}" Classes="metadata" AutomationProperties.Name="{Binding CountsAccessibleText}" />
                  <TextBlock Text="{Binding StatusText}" Classes="metadata" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ErrorText}" Classes="metadata" Classes.error="{Binding HasError}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                  <WrapPanel>
                    <Button Content="{local:Loc Key=agentProposalReview}" Command="{Binding ReviewCommand}" IsEnabled="{Binding IsAvailable}" Margin="0,0,6,0" />
                    <Button Content="{local:Loc Key=agentProposalApplyAll}" Command="{Binding ApplyAllCommand}" IsVisible="{Binding ShowApplyDiscard}" IsEnabled="{Binding CanApply}" Margin="0,0,6,0" />
                    <Button Content="{local:Loc Key=agentProposalDiscard}" Command="{Binding DiscardCommand}" IsVisible="{Binding ShowApplyDiscard}" IsEnabled="{Binding CanDiscard}" />
                    <Button Content="{local:Loc Key=agentProposalKeep}" Command="{Binding KeepCommand}" IsVisible="{Binding ShowKeepRevert}" Margin="0,0,6,0" />
                    <Button Content="{local:Loc Key=agentProposalRevert}" Command="{Binding RevertCommand}" IsVisible="{Binding ShowKeepRevert}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:AgentChatNoticeItem">
              <TextBlock Text="{Binding Content}" Classes="metadata" Classes.error="{Binding IsError}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
        <StackPanel x:Name="EmptyState" IsVisible="{Binding ShowEmptyInvitation}" VerticalAlignment="Center" Margin="16" Spacing="6" IsHitTestVisible="False">
          <TextBlock Text="{local:Loc Key=agentEmptyTitle}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="{local:Loc Key=agentEmptyBody}" Classes="metadata" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="3" Spacing="8">
        <Border Classes="card" Padding="8" IsVisible="{Binding IsSendBlocked}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="{Binding SendBlockText}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="{Binding SendBlockActionText}" Command="{Binding ResolveSendBlockCommand}" IsVisible="{Binding HasSendBlockAction}"/></Grid>
        </Border>
        <Button Content="{local:Loc Key=agentOpenPermissions}" Command="{Binding OpenPermissionsCommand}" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="6"><Button x:Name="WorkspaceFileButton" Content="{local:Loc Key=agentAttachWorkspaceFile}" Command="{Binding AttachWorkspaceFileCommand}"><Button.Flyout><Flyout><StackPanel Width="340" Spacing="6" Margin="8"><TextBox Text="{Binding WorkspaceFilePicker.Search}" PlaceholderText="{local:Loc Key=agentWorkspaceFileSearch}"/><TextBlock Text="{Binding WorkspaceFilePicker.Status}" Classes="metadata" TextWrapping="Wrap"/><ScrollViewer MaxHeight="320"><ItemsControl ItemsSource="{Binding WorkspaceFilePicker.Files}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:AgentWorkspaceFileChoice"><Button Content="{Binding RelativePath}" HorizontalContentAlignment="Left" Click="SelectWorkspaceFile" ToolTip.Tip="{local:Loc Key=agentAttachWorkspaceFileTooltip}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Flyout></Button.Flyout></Button><Button Content="{local:Loc Key=agentAttachExternalFile}" Command="{Binding AttachExternalFileCommand}" IsEnabled="{Binding CanAttachExternal}"/></StackPanel>
        <TextBox x:Name="Composer" Text="{Binding ComposerText}" IsEnabled="{Binding IsComposerEnabled}" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="64" MaxHeight="160" PlaceholderText="{local:Loc Key=agentComposerPlaceholder}" AutomationProperties.Name="{local:Loc Key=agentComposer}" ToolTip.Tip="{local:Loc Key=agentComposerShortcut}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CancelTurnButton" Content="{local:Loc Key=agentCancelTurn}" Command="{Binding CancelTurnCommand}" IsVisible="{Binding IsBusy}" ToolTip.Tip="{local:Loc Key=agentApprovalCancelNotice}" />
          <Button x:Name="SendButton" Content="{local:Loc Key=agentSend}" Classes="primary" Command="{Binding SendCommand}" IsEnabled="{Binding IsComposerEnabled}" ToolTip.Tip="{local:Loc Key=agentComposerShortcut}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
