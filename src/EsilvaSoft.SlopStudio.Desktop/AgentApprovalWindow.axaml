<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.SlopStudio.Desktop.ViewModels" xmlns:local="using:EsilvaSoft.SlopStudio.Desktop" x:Class="EsilvaSoft.SlopStudio.Desktop.AgentApprovalWindow" x:DataType="vm:AgentApprovalViewModel" x:CompileBindings="True" Title="{local:Loc Key=agentApprovalTitle}" Width="760" Height="560" MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner" CanResize="True">
  <Window.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="20">
    <StackPanel Spacing="4">
      <TextBlock Text="{local:Loc Key=agentApprovalTitle}" Classes="section-title" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{local:Loc Key=agentApprovalIntro}" Classes="metadata" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10" Margin="0,0,16,0">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
          <TextBlock Text="{local:Loc Key=agentApprovalTool}" Classes="metadata" />
          <TextBlock Grid.Column="1" x:Name="ToolValue" Text="{Binding ToolText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Text="{local:Loc Key=agentApprovalTarget}" Classes="metadata" />
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TargetValue" Text="{Binding TargetText}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Text="{local:Loc Key=agentApprovalFilter}" Classes="metadata" />
          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FilterText}" FontFamily="{StaticResource CodeFont}" FontSize="14" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Text="{local:Loc Key=agentApprovalLimit}" Classes="metadata" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LimitText}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="4" Text="{local:Loc Key=agentApprovalRisk}" Classes="metadata" />
          <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RiskValue" Text="{Binding RiskText}" FontWeight="SemiBold" Classes.error="{Binding IsDestructive}" />
        </Grid>
        <StackPanel Spacing="4">
          <TextBlock Text="{local:Loc Key=agentApprovalChange}" Classes="metadata" />
          <Border Classes="card" Padding="8">
            <SelectableTextBlock x:Name="ChangeValue" Text="{Binding ChangeText}" FontFamily="{StaticResource CodeFont}" FontSize="14" LineHeight="21" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding IsDestructive}">
          <TextBlock Text="{Binding DestructivePrompt}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBox x:Name="DestructiveInput" Text="{Binding DestructiveConfirmation}" IsEnabled="{Binding IsDecisionOpen}" AutomationProperties.Name="{local:Loc Key=agentApprovalDestructiveInput}" PlaceholderText="{local:Loc Key=agentApprovalDestructiveInput}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
      <TextBlock x:Name="ExpiryText" Text="{Binding RemainingText}" Classes="metadata" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Grid.Row="1" x:Name="MessageLine" Text="{Binding MessageText}" TextWrapping="Wrap" MaxLines="3" Classes.error="{Binding IsMessageError}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
      <Button Grid.Column="1" Grid.RowSpan="2" x:Name="RejectButton" Content="{local:Loc Key=agentApprovalReject}" Command="{Binding RejectCommand}" ToolTip.Tip="{local:Loc Key=agentApprovalRejectHint}" VerticalAlignment="Bottom" />
      <Button Grid.Column="2" Grid.RowSpan="2" x:Name="ApproveButton" Content="{local:Loc Key=agentApprovalApproveOnce}" Classes="primary" Command="{Binding ApproveOnceCommand}" ToolTip.Tip="{local:Loc Key=agentApprovalApproveHint}" VerticalAlignment="Bottom" />
    </Grid>
  </Grid>
</Window>
