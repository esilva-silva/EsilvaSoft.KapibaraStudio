<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:EsilvaSoft.SlopStudio.Desktop.ViewModels" xmlns:local="using:EsilvaSoft.SlopStudio.Desktop" x:Class="EsilvaSoft.SlopStudio.Desktop.ConnectionsWindow" x:DataType="vm:ConnectionsViewModel" Title="{local:Loc Key=connectionsTitle}" Width="800" Height="560" MinWidth="600" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="{local:Loc Key=connectionsTitle}" Classes="section-title"/>
        <TextBlock Text="{local:Loc Key=chooseOrigin}" Classes="muted"/>
      </StackPanel>
      <Button Grid.Column="1" Content="{local:Loc Key=newConnection}" IsVisible="{Binding !Editor.IsProfileEditorVisible}" Command="{Binding Editor.ShowProfileEditorCommand}"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" IsVisible="{Binding !Editor.IsProfileEditorVisible}" IsEnabled="{Binding !IsOpening}">
        <TextBox x:Name="SearchBox" Text="{Binding Search}" PlaceholderText="{local:Loc Key=searchConnections}" AutomationProperties.Name="{local:Loc Key=connectionSearch}"/>
        <Grid Grid.Row="1"><ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DoubleTapped="OpenSelected">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConnectionChoice">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="4,6">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Endpoint}" Classes="metadata"/>
                <TextBlock Grid.Row="1" Text="{Binding Details}" Classes="metadata"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox><TextBlock IsVisible="{Binding HasNoMatches}" Text="{local:Loc Key=noConnections}" Classes="muted" TextWrapping="Wrap" Margin="12,24" VerticalAlignment="Top"/></Grid>
        <WrapPanel Grid.Row="2">
          <Button Content="{local:Loc Key=edit}" Command="{Binding Editor.EditSelectedProfileCommand}" Margin="0,0,8,0"/>
          <Button Content="{local:Loc Key=duplicate}" Command="{Binding Editor.DuplicateSelectedProfileCommand}" Margin="0,0,8,0"/>
          <Button Content="{local:Loc Key=removeProfile}" Classes="danger" Click="DeleteProfile"/>
          <TextBlock Text="{local:Loc Key=removeLocalOnly}" Classes="metadata" VerticalAlignment="Center" Margin="8,0"/>
        </WrapPanel>
      </Grid>
      <ScrollViewer IsVisible="{Binding Editor.IsProfileEditorVisible}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Right gutter keeps the vertical scroll bar off the right-column fields (design system: local scrolling). -->
        <StackPanel DataContext="{Binding Editor}" x:DataType="vm:MainWindowViewModel" Spacing="8" Margin="0,0,16,0">
          <TextBlock Text="{local:Loc Key=fillFromUri}" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding QuickConnectionString}" PlaceholderText="mongodb://servidor:27017/banco" AutomationProperties.Name="{local:Loc Key=quickUri}"/>
            <Button Grid.Column="1" Content="{local:Loc Key=fill}" Command="{Binding StartProfileFromConnectionStringCommand}"/>
          </Grid>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Text="{local:Loc Key=name}"/>
            <TextBlock Grid.Column="1" Text="{local:Loc Key=defaultDatabase}"/>
            <TextBox Grid.Row="1" Text="{Binding NewProfileName}" AutomationProperties.Name="{local:Loc Key=connectionName}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewProfileDatabase}" AutomationProperties.Name="{local:Loc Key=defaultDatabase}"/>
            <TextBlock Grid.Row="2" Text="{local:Loc Key=mongodbUri}"/>
            <TextBox Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding NewProfileConnectionString}" AutomationProperties.Name="{local:Loc Key=mongodbUri}"/>
            <TextBlock Grid.Row="4" Text="{local:Loc Key=user}"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{local:Loc Key=passwordInConnection}"/>
            <TextBox Grid.Row="5" Text="{Binding NewProfileUsername}" AutomationProperties.Name="{local:Loc Key=user}"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding NewProfilePassword}" AutomationProperties.Name="{local:Loc Key=passwordInConnection}" PasswordChar="●"/>
            <TextBlock Grid.Row="6" Text="{local:Loc Key=environmentLabel}"/>
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{local:Loc Key=folder}"/>
            <TextBox Grid.Row="7" Text="{Binding NewProfileEnvironment}" AutomationProperties.Name="{local:Loc Key=environment}"/>
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding NewProfileFolder}" AutomationProperties.Name="{local:Loc Key=environmentFolder}"/>
            <TextBlock Grid.Row="8" Text="{local:Loc Key=environmentColor}"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{local:Loc Key=tags}"/>
            <TextBox Grid.Row="9" Text="{Binding NewProfileColor}" AutomationProperties.Name="{local:Loc Key=environmentColor}"/>
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding NewProfileTags}" AutomationProperties.Name="{local:Loc Key=tags}"/>
          </Grid>
          <TextBlock Text="{local:Loc Key=connectionUriNote}" Classes="metadata" TextWrapping="Wrap"/>
          <WrapPanel>
            <CheckBox Content="{local:Loc Key=favorite}" IsChecked="{Binding NewProfileIsFavorite}" Margin="0,0,20,0"/>
            <CheckBox Content="{local:Loc Key=readOnly}" IsChecked="{Binding NewProfileIsReadOnly}"/>
          </WrapPanel>
          <local:UuidRepresentationPanel x:Name="ProfileUuidPanel" IsVisible="False" Margin="0,8,0,0"/>
          
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock Text="{local:Loc Key=openingConnection}" IsVisible="{Binding IsOpening}" Foreground="{DynamicResource AccentBrush}"/>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Editor.StatusMessage}" Classes="metadata" TextWrapping="Wrap" MaxHeight="48"/>
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" IsEnabled="{Binding !IsOpening}">
        <Button Content="{local:Loc Key=testConnection}" Command="{Binding Editor.TestSelectedConnectionCommand}" IsVisible="{Binding !Editor.IsProfileEditorVisible}"/>
        <Button Grid.Column="2" Content="{local:Loc Key=back}" Command="{Binding Editor.HideProfileEditorCommand}" IsVisible="{Binding Editor.IsProfileEditorVisible}"/>
        <Button Grid.Column="3" Content="{local:Loc Key=close}" Click="CloseDialog"/>
        <Button Grid.Column="4" x:Name="SaveProfileButton" Content="{local:Loc Key=saveProfile}" Classes="primary" Command="{Binding Editor.SaveProfileCommand}" IsVisible="{Binding Editor.IsProfileEditorVisible}"/>
        <Button Grid.Column="4" Content="{local:Loc Key=openConnection}" Classes="primary" Click="OpenSelected" IsVisible="{Binding !Editor.IsProfileEditorVisible}"/>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
