{
  "schema": "kapilab-kapi-model-v1",
  "name": "KapiCoder-Mongo-Agent (exemplo de contrato, sem pesos)",
  "contextContract": "editor-context-v1",
  "agentContract": "local-agent-qwen3-v1",
  "capabilities": [
    "chat",
    "agent",
    "tools",
    "reasoning"
  ],
  "runtime": {
    "minimumGenAi": "0.15.2"
  },
  "agent": {
    "promptFormat": "qwen3-chatml-tools-v1",
    "chatTemplateFile": "chat_template.jinja",
    "toolCallFormat": "qwen-hermes-json",
    "toolSchemaVersion": "kapibara-tools-2026-10",
    "maxToolCallsPerTurn": 12,
    "maxToolResultBytes": 6144
  },
  "reasoning": {
    "supported": true,
    "format": "qwen3-think",
    "startTokenId": 151667,
    "endTokenId": 151668,
    "defaultEnabled": true,
    "toggle": "hard",
    "disabledGenerationSuffix": "<think>\n\n</think>\n\n",
    "budgetTokens": {
      "default": 512,
      "minimum": 1,
      "maximum": 8192
    },
    "turnBudgetTokens": 8192,
    "onBudgetExceeded": "force-close",
    "forceCloseText": "Considering the limited time by the user, I have to give the solution based on the thinking directly now.\n</think>\n\n",
    "history": "strip-previous-turns",
    "templateSha256": "a55ee1b1660128b7098723e0abcd92caa0788061051c62d51cbe87d9cf1974d8"
  },
  "generation": {
    "agent": {
      "maxAnswerTokensPerStep": 256,
      "sampling": {
        "thinking": {
          "temperature": 0.6,
          "topP": 0.95,
          "topK": 20
        },
        "nonThinking": {
          "temperature": 0.7,
          "topP": 0.8,
          "topK": 20
        }
      }
    }
  }
}
